  "components": {
    "schemas": {
      "CompleteConnectionOAuthAttemptRequest": {
        "required": [
          "completionHandle"
        ],
        "type": "object",
        "properties": {
          "completionHandle": {
            "type": "string"
          }
        }
      },
      "ConnectionAccessSummary": {
        "required": [
          "createdBy",
          "isPublic",
          "sharedWithUsers",
          "sharedWithRoles",
          "revision",
          "eTag"
        ],
        "type": "object",
        "properties": {
          "createdBy": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "isPublic": {
            "type": "boolean"
          },
          "sharedWithUsers": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          },
          "sharedWithRoles": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          },
          "revision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "eTag": {
            "type": "string"
          }
        }
      },
      "ConnectionAuthMode": {
        "type": "integer"
      },
      "ConnectionAuthModeMetadata": {
        "required": [
          "authMode",
          "displayName",
          "description",
          "secretSettingKeys",
          "publicSettingKeys"
        ],
        "type": "object",
        "properties": {
          "authMode": {
            "$ref": "#/components/schemas/ConnectionAuthMode"
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "secretSettingKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publicSettingKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ConnectionCapabilities": {
        "required": [
          "supportsTest",
          "supportsSchemaDiscovery"
        ],
        "type": "object",
        "properties": {
          "supportsTest": {
            "type": "boolean"
          },
          "supportsSchemaDiscovery": {
            "type": "boolean"
          }
        }
      },
      "ConnectionCatalog": {
        "required": [
          "categories",
          "providers",
          "authModes"
        ],
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConnectionCategoryMetadata"
            }
          },
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConnectionProviderMetadata"
            }
          },
          "authModes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConnectionAuthModeMetadata"
            }
          }
        }
      },
      "ConnectionCategory": {
        "type": "integer"
      },
      "ConnectionCategoryMetadata": {
        "required": [
          "category",
          "displayName",
          "description"
        ],
        "type": "object",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/ConnectionCategory"
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ConnectionDocumentation": {
        "required": [
          "overview",
          "whenToUse",
          "pitfalls",
          "seeAlso"
        ],
        "type": "object",
        "properties": {
          "overview": {
            "type": "string"
          },
          "whenToUse": {
            "type": "string"
          },
          "pitfalls": {
            "type": "string"
